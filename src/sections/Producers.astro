---
import AccordionGroup from "@components/ui/AccordionGroup.astro";
import AccordionItem from "@components/ui/AccordionItem.astro";
const { lang = 'da' } = Astro.props;
---

<section id="partners" class="max-w-7xl mx-auto px-6 md:px-48 py-12 md:py-24">
  <h2 class="text-3xl md:text-2xl font-bold tracking-wide text-text-heading mb-8">{lang === 'da' ? 'Producenter' : 'Producers'}</h2>
  <AccordionGroup>

    <AccordionItem
      title="Giuseppe Rinaldi"
      subtitle="Azienda Agricola Giuseppe Rinaldi s.s.a."
      address="Via Monforte, 3 - 12060 Barolo CN"
    >
      <p class="max-w-2xl">
        {lang === 'da'
          ? 'Giuseppe Rinaldi er en af Barolos mest kompromisløse producenter. Med rødder tilbage til 1890\'erne dyrker familien Nebbiolo på de ikoniske marker Brunate og Le Coste. Vinene er lavet med minimal indgriben – lange macerationer, store egetræsfade og ingen filtrering.'
          : 'Giuseppe Rinaldi is one of Barolo\'s most uncompromising producers. With roots dating back to the 1890s, the family cultivates Nebbiolo on the iconic vineyards of Brunate and Le Coste. The wines are made with minimal intervention – long macerations, large oak casks and no filtration.'}
      </p>
    </AccordionItem>

    <AccordionItem
      title="Bartolo Mascarello"
      subtitle="Cantina Bartolo Mascarello"
      address="Via Roma, 15 - 12060 Barolo CN"
    >
      <p class="max-w-2xl">
        {lang === 'da'
          ? 'Bartolo Mascarello er en legende i Barolo. Ejendommen er kendt for sine uvildige holdninger og sine vine, der afspejler en svunden tids håndværk. I dag drives den af datteren Maria Teresa, der viderefører faderens filosofi med samme integritet.'
          : 'Bartolo Mascarello is a legend in Barolo. The estate is known for its outspoken views and wines that reflect a bygone era of craftsmanship. Today it is run by daughter Maria Teresa, who continues her father\'s philosophy with the same integrity.'}
      </p>
    </AccordionItem>

    <AccordionItem
      title="Cappellano"
      subtitle="Dr. Giuseppe Cappellano"
      address="Serralunga d'Alba - 12050 CN"
    >
      <p class="max-w-2xl">
        {lang === 'da'
          ? 'Cappellano er en historisk ejendom i Serralunga d\'Alba, bedst kendt for at have opfundet Barolo Chinato – den aromatiserede vin baseret på Nebbiolo og kinin. Familien producerer også strenge, terroir-drevne Barolo-vine fra Gabutti-marken.'
          : 'Cappellano is a historic estate in Serralunga d\'Alba, best known for having invented Barolo Chinato – the aromatised wine based on Nebbiolo and quinine. The family also produces austere, terroir-driven Barolo wines from the Gabutti vineyard.'}
      </p>
    </AccordionItem>

  </AccordionGroup>
</section>
