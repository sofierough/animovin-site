---
const { lang = 'da' } = Astro.props;
---

<footer class="bg-[#C4B9A8] text-[#2c2c2c] px-6 py-10">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start gap-8">

    <div>
      <div class="font-display italic text-2xl text-accent">Animo Vin</div>
      <p class="mt-3 text-xs opacity-60">&copy; 2026 &bull; {lang === 'da' ? 'Alle rettigheder forbeholdes.' : 'All rights reserved.'}</p>
    </div>

    <div class="flex flex-col items-end gap-2 text-xs opacity-70">
      <a href="https://instagram.com/animovin" target="_blank" rel="noopener" class="flex items-center gap-1.5 hover:opacity-100 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
        </svg>
        Instagram
      </a>
      <p>CVR: 12345678</p>
      <p>{lang === 'da' ? 'København, Danmark' : 'Copenhagen, Denmark'}</p>
    </div>

  </div>
</footer>
