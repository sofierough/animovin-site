---
const { lang = 'da' } = Astro.props;
---

<section id="contact" class="max-w-7xl mx-auto px-6 py-12 md:py-24">
  <h2 class="text-3xl md:text-2xl font-bold tracking-wide text-text-heading">{lang === 'da' ? 'Kontakt' : 'Contact'}</h2>
  <p class="mt-6 text-text-primary font-serif">
    {lang === 'da'
      ? 'Du kan komme i kontakt med os ved at ringe eller skrive en mail.'
      : 'You can get in touch with us by calling or sending an email.'}
  </p>
  <a href="mailto:hello@animovin.dk" class="block mt-4 text-text-primary underline hover:text-text-heading transition-colors font-serif">
    hello@animovin.dk
  </a>
  <a href="tel:+4512345678" class="block mt-2 text-text-primary underline hover:text-text-heading transition-colors font-serif">
    +45 12 34 56 78
  </a>
</section>
